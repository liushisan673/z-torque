APP_NAME=Z-Torque
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
DATABASE_URL=sqlite:///./data/z_torque.db

# 模型接入（OpenAI 兼容）；MODEL_API_KEY 支持 secret:// 引用（经 secret.provider 解密）
# 【重要】留空 = 未配置模型。此时对话/任务会显式返回 AI_MODEL_NOT_CONFIGURED，
# 必须先在控制台「模型管理」里配置至少一个模型才能使用（不再静默降级为 Mock 假回复）。
# 保留为可选：部署方也可以在这里填好，作为未绑定模型时的全局默认。
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# 模型白名单（JSON 数组）：AgentVersion 快照绑定的模型名必须命中，否则回退 MODEL_NAME；留空 = 不限制
MODEL_ALLOWED_NAMES=["deepseek-chat", "deepseek-reasoner", "deepseek-flash", "deepseek-v4-pro"]
# 全局兜底模型参数：AgentVersion 快照绑定的 temperature/max_tokens 优先，未设置时生效
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=1024
MODEL_TIMEOUT_SECONDS=60
JWT_SECRET_KEY=replace-with-a-development-secret
SECRET_STORE_KEY=replace-with-a-fernet-key
SECRET_STORE_DIR=./data/secrets
FILE_STORAGE_DIR=./data/files

# 装配档位：单一系统，community 与 enterprise 现为同一全量装配（保留两名为兼容旧配置）
# 仍支持追加写法：<基础档>+<Module 或插件>[,<...>] 用于外部插件选配；
# 条目不存在、或重复选配基础档已有的插件都会拒绝启动（不静默忽略）
ASSEMBLY_PROFILE=community

# ---- 运行开关：默认全开（单一系统，无版本差距）----
# 审计导出允许的格式（JSON 数组；jsonl + csv）
AUDIT_EXPORT_FORMATS=["jsonl","csv"]
# A2A 入站总开关（默认开启；关闭时端点仍注册，返回 AI_A2A_DISABLED 503）
A2A_ENABLED=true
# MD-Skill 脚本执行总开关（默认开启）
MD_SKILL_SCRIPT_ENABLED=true
# Windows 有限解禁：需技能 frontmatter 声明 windows_trusted=true + 每次工具调用人工确认 +
# 路径白名单强制收口（脚本必须落在 MD_SKILLS_DIR 下）；设为 false 可在 exe 上完全关闭
MD_SKILL_WINDOWS_PROCESS_ENABLED=true

# 显式 Port 覆盖（优先级：显式配置 > 第三方插件 > 内置默认）
# 格式：port.name=module:factory，多个用英文逗号分隔
# 例：PORT_OVERRIDES=memory.working=my_pkg.impl:working_factory
PORT_OVERRIDES=

# 跨域白名单（逗号分隔；留空表示仅同源）
CORS_ALLOW_ORIGINS=

# 单端口交付：开启后后端在 / 上直接提供 console/dist（前端与 API 同源，无需 CORS）
# 需先 cd console && npm run build；未构建时自动跳过，不影响 vite dev server
SERVE_CONSOLE=false
# 前端构建产物目录（相对仓库根；仅在 SERVE_CONSOLE=true 时生效）
CONSOLE_DIST_DIR=./console/dist

# 生产环境（APP_ENV=production）额外校验：ADMIN_INITIAL_PASSWORD 需 ≥12 位非弱口令，
# JWT_SECRET_KEY 需 ≥32 位高熵字符串，APP_DEBUG 必须为 false
ADMIN_INITIAL_PASSWORD=

# 通用入站 Webhook：工具型任务完成后等待最终回复落库的上限（秒）
INBOUND_WEBHOOK_TASK_WATCH_SECONDS=600
# 通用入站 Webhook：回写外部系统的单次请求超时（秒）
INBOUND_WEBHOOK_REPLY_TIMEOUT_SECONDS=10
# 工具执行成功即视为外部系统已收到答复的工具名（JSON 数组）；用于跳过 reply_url 自动回写
# 由接入方按自身工具配置，系统不内置任何外部平台工具名；例如：
# INBOUND_WEBHOOK_REPLY_SENT_TOOLS=["ext.send_text","ext.send_media"]
INBOUND_WEBHOOK_REPLY_SENT_TOOLS=[]
# 出站媒体导出响应中提示智能体使用的发送工具名；留空则不返回 send_media 提示
# BRIDGE_MEDIA_SEND_TOOL=ext.send_media

# ---- 入站 Webhook 媒体能力（主应用内，复用 POST /webhooks/{id}）----
# 本地媒体根目录白名单（JSON 数组）；Webhook 的 media.filePath 只能落在这些目录内
# 例如 Windows: INBOUND_MEDIA_ROOTS=["D:\\shared-media"]
# 容器部署时与外部服务挂载同一个卷，例如 ["/tmp/shared-media"]
INBOUND_MEDIA_ROOTS=[]
INBOUND_MEDIA_TIMEOUT_SECONDS=15
# 单个附件上限（MB）与单条消息附件数上限
INBOUND_MAX_FILE_MB=20
INBOUND_MAX_FILES=5
# 声明 MIME 白名单（JSON 数组）；真实类型仍由扩展名 + 魔术字节校正
# INBOUND_ALLOWED_MEDIA_TYPES=["image/jpeg","image/png","image/gif","image/webp"]

# ---- 出站媒体：导出到外部服务共享卷 ----
# 宿主机目录（外部服务容器 bind mount 的同一目录）；留空时复用 INBOUND_MEDIA_ROOTS[0]
# BRIDGE_MEDIA_SHARED_ROOT=D:/tmp/shared-media
# 该目录在外部服务容器内的路径；发送工具的 url 参数传这个容器路径
# BRIDGE_MEDIA_CONTAINER_ROOT=/tmp/shared-media
# 入站媒体目录（INBOUND_MEDIA_ROOTS）在外部服务容器内的路径，用于直接复用入站媒体
# BRIDGE_MEDIA_INBOUND_CONTAINER_ROOT=/tmp/shared-media
# 导出子目录，避免与外部服务的 inbound 媒体混在一起
# BRIDGE_MEDIA_OUTBOUND_SUBDIR=outbound

# ---- 多模态上下文 ----
# 单条消息最多注入图片数 / 单张图片上限（MB）/ 历史消息图片注入条数（0=只当前消息）
MODEL_MAX_IMAGES_PER_MESSAGE=4
MODEL_MAX_IMAGE_MB=5
MODEL_IMAGE_HISTORY_LIMIT=0
