APP_NAME=Z-Torque
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
DATABASE_URL=sqlite:///./data/z_torque.db

# 模型接入（OpenAI 兼容）；MODEL_API_KEY 支持 secret:// 引用（经 secret.provider 解密）
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=mock
# 模型白名单（JSON 数组）：AgentVersion 快照绑定的模型名必须命中，否则回退 MODEL_NAME；留空 = 不限制
MODEL_ALLOWED_NAMES=["deepseek-chat", "deepseek-reasoner", "deepseek-flash", "deepseek-v4-pro"]
# 全局兜底模型参数：AgentVersion 快照绑定的 temperature/max_tokens 优先，未设置时生效
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=1024
MODEL_TIMEOUT_SECONDS=60
JWT_SECRET_KEY=replace-with-a-development-secret
SECRET_STORE_KEY=replace-with-a-fernet-key
SECRET_STORE_DIR=./data/secrets
FILE_STORAGE_DIR=./data/files

# 装配档位：community（默认）| enterprise（= 社区 + 审计导出归档 + A2A）
# 需要"社区版按需选配插件"时用追加写法：<基础档>+<Module 或插件>[,<...>]
# 例：ASSEMBLY_PROFILE=community+audit_export_archive,a2a
# 只做追加；条目不存在、或重复选配基础档已有的插件都会拒绝启动（不静默忽略）
ASSEMBLY_PROFILE=community

# ---- 三插件运行开关：装配 ≠ 启用 ----
# 审计导出允许的格式（JSON 数组；默认仅 jsonl，放开 csv 需显式声明）
AUDIT_EXPORT_FORMATS=["jsonl"]
# A2A 入站总开关（默认 false；关闭时端点仍注册，返回 AI_A2A_DISABLED 503）
A2A_ENABLED=false
# MD-Skill 脚本执行总开关（沙箱已装配，但脚本默认不执行）
MD_SKILL_SCRIPT_ENABLED=false

# 显式 Port 覆盖（优先级：显式配置 > 第三方插件 > 内置默认）
# 格式：port.name=module:factory，多个用英文逗号分隔
# 例：PORT_OVERRIDES=memory.working=my_pkg.impl:working_factory
PORT_OVERRIDES=

# 跨域白名单（逗号分隔；留空表示仅同源）
CORS_ALLOW_ORIGINS=

# 单端口交付：开启后后端在 / 上直接提供 console/dist（前端与 API 同源，无需 CORS）
# 需先 cd console && npm run build；未构建时自动跳过，不影响 vite dev server
SERVE_CONSOLE=false
# 前端构建产物目录（相对仓库根；仅在 SERVE_CONSOLE=true 时生效）
CONSOLE_DIST_DIR=./console/dist

# 生产环境（APP_ENV=production）额外校验：ADMIN_INITIAL_PASSWORD 需 ≥12 位非弱口令，
# JWT_SECRET_KEY 需 ≥32 位高熵字符串，APP_DEBUG 必须为 false
ADMIN_INITIAL_PASSWORD=

# ---- 企微能力服务事件订阅（AI 中台作为接收方）----
# 能力服务把企微入站事件推送到本服务；本服务不直连企业微信 API。
# 不填则 Webhook 返回 503，其他功能不受影响。
WECOM_SERVICE_BASE_URL=
WECOM_SERVICE_TOKEN=
WECOM_SUB_SECRET=
# 能力服务订阅时配置的回调路径（不要带 /api/z-torque 前缀）
WECOM_EVENT_PATH=/wecom/events
# 事件 ID 去重窗口（秒），不得小于 86400
WECOM_DEDUPE_TTL_SECONDS=86400
WECOM_SERVICE_TIMEOUT_SECONDS=10
# 入站消息桥接到控制台 Chat 页（复用现有 Conversation/Message，不新增表）
WECOM_CHAT_ENABLED=true
# 用哪个本地账号承载企微会话（登录该账号即可在 Chat 页看到「企微 · xxx」）
WECOM_CHAT_OWNER_USERNAME=admin
# 指定会话使用的 Agent；留空则取租户内第一个已发布 Agent
WECOM_CHAT_AGENT_ID=
# 按通道拆分 Agent（优先于 WECOM_CHAT_AGENT_ID）：
# 自建应用 / 智能机器人 / 微信客服，各自绑定对应工具
WECOM_AGENT_ID_APP=
WECOM_AGENT_ID_BOT=
WECOM_AGENT_ID_KF=
# Agent 任务型回复的等待上限（秒）
WECOM_TASK_REPLY_TIMEOUT_SECONDS=120
# 通用入站 Webhook：工具型任务完成后等待最终回复落库的上限（秒）
INBOUND_WEBHOOK_TASK_WATCH_SECONDS=600
# 通用入站 Webhook：回写外部系统的单次请求超时（秒）
INBOUND_WEBHOOK_REPLY_TIMEOUT_SECONDS=10

# ---- 入站 Webhook 媒体能力（主应用内，复用 POST /webhooks/{id}）----
# 本地媒体根目录白名单（JSON 数组）；Webhook 的 media.filePath 只能落在这些目录内
# 例如 Windows: INBOUND_MEDIA_ROOTS=["D:\\weixin-agent\\media"]
# 容器部署时与 Bot 挂载同一个卷，例如 ["/tmp/weixin-agent/media"]
INBOUND_MEDIA_ROOTS=[]
INBOUND_MEDIA_TIMEOUT_SECONDS=15
# 单个附件上限（MB）与单条消息附件数上限
INBOUND_MAX_FILE_MB=20
INBOUND_MAX_FILES=5
# 声明 MIME 白名单（JSON 数组）；真实类型仍由扩展名 + 魔术字节校正
# INBOUND_ALLOWED_MEDIA_TYPES=["image/jpeg","image/png","image/gif","image/webp"]

# ---- 出站媒体：导出到 wechat-Bot 共享卷 ----
# 宿主机目录（Bridge 容器 bind mount 的同一目录）；留空时复用 INBOUND_MEDIA_ROOTS[0]
# BRIDGE_MEDIA_SHARED_ROOT=D:/tmp/weixin-agent/media
# 该目录在 Bridge 容器内的路径；weixin.send_media 的 url 传这个容器路径
# BRIDGE_MEDIA_CONTAINER_ROOT=/tmp/weixin-agent/media
# 入站媒体目录（INBOUND_MEDIA_ROOTS）在 Bridge 容器内的路径，用于直接复用入站媒体
# BRIDGE_MEDIA_INBOUND_CONTAINER_ROOT=/tmp/weixin-agent/media
# 导出子目录，避免与 Bridge 的 inbound 媒体混在一起
# BRIDGE_MEDIA_OUTBOUND_SUBDIR=outbound

# ---- 多模态上下文 ----
# 单条消息最多注入图片数 / 单张图片上限（MB）/ 历史消息图片注入条数（0=只当前消息）
MODEL_MAX_IMAGES_PER_MESSAGE=4
MODEL_MAX_IMAGE_MB=5
MODEL_IMAGE_HISTORY_LIMIT=0
