APP_NAME=Z-Torque
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false
DATABASE_URL=sqlite:///./data/z_torque.db

# 模型接入（OpenAI 兼容）；MODEL_API_KEY 支持 secret:// 引用（经 secret.provider 解密）
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=mock
# 模型白名单（JSON 数组）：AgentVersion 快照绑定的模型名必须命中，否则回退 MODEL_NAME；留空 = 不限制
MODEL_ALLOWED_NAMES=["deepseek-chat", "deepseek-reasoner", "deepseek-flash", "deepseek-v4-pro"]
# 全局兜底模型参数：AgentVersion 快照绑定的 temperature/max_tokens 优先，未设置时生效
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=1024
MODEL_TIMEOUT_SECONDS=60
JWT_SECRET_KEY=replace-with-a-development-secret
SECRET_STORE_KEY=replace-with-a-fernet-key
SECRET_STORE_DIR=./data/secrets
FILE_STORAGE_DIR=./data/files

# 装配档位：community（默认）| enterprise（= 社区 + 审计导出归档 + A2A）
# 需要"社区版按需选配插件"时用追加写法：<基础档>+<Module 或插件>[,<...>]
# 例：ASSEMBLY_PROFILE=community+audit_export_archive,a2a
# 只做追加；条目不存在、或重复选配基础档已有的插件都会拒绝启动（不静默忽略）
ASSEMBLY_PROFILE=community

# ---- 三插件运行开关：装配 ≠ 启用 ----
# 审计导出允许的格式（JSON 数组；默认仅 jsonl，放开 csv 需显式声明）
AUDIT_EXPORT_FORMATS=["jsonl"]
# A2A 入站总开关（默认 false；关闭时端点仍注册，返回 AI_A2A_DISABLED 503）
A2A_ENABLED=false
# MD-Skill 脚本执行总开关（沙箱已装配，但脚本默认不执行）
MD_SKILL_SCRIPT_ENABLED=false

# 显式 Port 覆盖（优先级：显式配置 > 第三方插件 > 内置默认）
# 格式：port.name=module:factory，多个用英文逗号分隔
# 例：PORT_OVERRIDES=memory.working=my_pkg.impl:working_factory
PORT_OVERRIDES=

# 跨域白名单（逗号分隔；留空表示仅同源）
CORS_ALLOW_ORIGINS=

# 单端口交付：开启后后端在 / 上直接提供 console/dist（前端与 API 同源，无需 CORS）
# 需先 cd console && npm run build；未构建时自动跳过，不影响 vite dev server
SERVE_CONSOLE=false
# 前端构建产物目录（相对仓库根；仅在 SERVE_CONSOLE=true 时生效）
CONSOLE_DIST_DIR=./console/dist

# 生产环境（APP_ENV=production）额外校验：ADMIN_INITIAL_PASSWORD 需 ≥12 位非弱口令，
# JWT_SECRET_KEY 需 ≥32 位高熵字符串，APP_DEBUG 必须为 false
ADMIN_INITIAL_PASSWORD=
