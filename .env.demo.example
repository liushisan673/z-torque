# ============================================================
# 演示/验收环境变量（docker compose 用）
# 首次运行 scripts\run_demo.ps1 会复制本文件为 .env.demo，
# 自动生成 JWT/SECRET_STORE 密钥，并从本机 .env 带入模型密钥。
# .env.demo 已被 .gitignore 排除，不得提交、不得随包交付。
# ============================================================

# production 会额外强校验：管理员口令 >=12 位且非弱口令、JWT_SECRET_KEY >=32 位高熵
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./data/z_torque.db

# ---- 安全密钥：占位值必须替换（run_demo.ps1 会自动生成随机值）----
JWT_SECRET_KEY=CHANGE_ME
SECRET_STORE_KEY=CHANGE_ME

# ---- 初始管理员：仅首次建库时创建；库中已有 admin 时不会改密码 ----
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=Zt-Demo-2026!

# ---- 模型接入（现场需要外网；断网则对话不可用）----
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_NAME=deepseek-chat
MODEL_ALLOWED_NAMES=["deepseek-chat", "deepseek-reasoner"]
MODEL_TIMEOUT_SECONDS=60

# ---- 装配档位：enterprise = 社区 + 审计导出归档 + A2A（演示 v1.3/v1.4 能力面）----
# 只想演示社区版基础能力时改回 community
ASSEMBLY_PROFILE=enterprise
AUDIT_EXPORT_FORMATS=["jsonl", "csv"]
A2A_ENABLED=false
# 容器内为 Linux，沙箱可用 rlimit；需要演示 MD-Skill 脚本执行时改为 true
MD_SKILL_SCRIPT_ENABLED=false

# ---- 单端口同源托管：后端直接提供 console/dist，无需跨域 ----
SERVE_CONSOLE=true
CORS_ALLOW_ORIGINS=
